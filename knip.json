{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "coverage/**",
    "**/paraglide/**",
    "packages/oxlint-plugins/dist/**",
    "packages/scripts/dist/**"
  ],
  "tags": ["-@internal"],
  "workspaces": {
    "apps/web": {
      "tanstack-router": {
        "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!"]
      },
      "entry": [
        "public/sw.js!",
        "src/server.ts!",
        "src/test/stubJsdomWindow.ts!",
        "src/test/testFetch.ts!",
        "src/test/htmlElement.ts!",
        "src/test/renderResource.ts!",
        "src/test/convexTestHarness.ts!",
        "src/test/convexTestSeed.ts!",
        "src/test/renderWithConvexTest.tsx!",
        "src/test/renderMountedFileRoute.tsx!",
        "src/test/routeTestContext.ts!",
        "src/test/overlayControl.tsx!",
        "src/test/untilCalled.ts!",
        "vite.config.ts!",
        "scripts/deploy-convex.ts!",
        "scripts/build-web.mjs!",
        "scripts/write-convex-url.mjs!"
      ]
    },
    "packages/convex": {
      "entry": [
        "scripts/ensureLocalEnv.ts!",
        "scripts/seedHomepageDemo.ts!",
        "scripts/seedHomepagePhotosDeferred.ts!"
      ]
    },
    "packages/oxlint-plugins": {
      "entry": [
        "workspace.ts!",
        "anti-slop/index.ts!",
        "nkzw/index.ts!",
        "infer-callback-params.ts!",
        "inline-jsx-callback.ts!",
        "no-banned-react-reexport.ts!",
        "no-convex-optional.ts!",
        "no-convex-query-hooks.ts!",
        "no-custom-test-timeout.ts!",
        "no-invalid-convex-client.ts!",
        "no-manual-memoization.ts!",
        "no-mock.ts!",
        "no-optional.ts!",
        "no-overzealous-destructuring.ts!",
        "no-rhf-watch.ts!",
        "no-test-preloaded-query.ts!",
        "no-use-effect.ts!",
        "no-use-state.ts!",
        "query-prefetch-shared.ts!",
        "require-preloaded-query-options.ts!",
        "use-loader-preloads.ts!"
      ]
    },
    "packages/scripts": {
      "entry": ["src/compareCoverage.ts!"]
    },
    "packages/runtime": {},
    "packages/form-guard": {},
    "packages/email": {
      "entry": ["emails/**/*.{ts,tsx}!", "src/index.ts!"]
    },
    "packages/query-prefetch": {},
    "packages/convex-prefetch": {},
    "packages/ui": {},
    "tooling/typescript": {}
  }
}

{
  "name": "@workspace/convex-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",

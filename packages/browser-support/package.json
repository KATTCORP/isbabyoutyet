{
  "name": "@workspace/browser-support",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./head": "./src/head.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "core-js": "catalog:",
    "core-js-compat": "catalog:",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/tsconfig": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}

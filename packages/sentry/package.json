{
  "name": "@workspace/sentry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser": "./src/browser.ts",
    "./capture": "./src/capture.ts",
    "./project": "./src/project.ts",
    "./server": "./src/server.ts",
    "./start": "./src/start.ts",
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@workspace/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@workspace/tsconfig": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0"
  }
}

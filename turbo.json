{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "CONVEX_DEPLOY_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL",
        "VITE_SITE_URL",
        "VITE_HAS_DEMO_LOGIN",
        "VERCEL",
        "VERCEL_ENV"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "VERCEL_GIT_COMMIT_REF", "VERCEL_BRANCH_URL", "VERCEL_PROJECT_PRODUCTION_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [
        "node_modules/.cache/tsbuildinfo.json",
        "node_modules/.cache/tsbuildinfo.convex.json"
      ]
    },
    "test": {},
    "lint": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "lint-fix": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "format": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "//#test:coverage": {
      "outputs": [
        "coverage/coverage-summary.json",
        "coverage/lcov.info"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/projects/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/**",
        "!$TURBO_ROOT$/packages/oxlint-plugins/*.ts",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/coverage/**",
        "!$TURBO_ROOT$/**/paraglide/**",
        "!$TURBO_ROOT$/**/project.inlang/cache/**",
        "!$TURBO_ROOT$/**/project.inlang/.gitignore",
        "!$TURBO_ROOT$/**/project.inlang/.meta.json",
        "!$TURBO_ROOT$/**/project.inlang/README.md",
        "!$TURBO_ROOT$/**/*.md",
        "!$TURBO_ROOT$/.github/**",
        "!$TURBO_ROOT$/**/.agents/**",
        "!$TURBO_ROOT$/.cursor/**"
      ],
      "env": ["CI"]
    },
    "//#knip": {
      "cache": false
    }
  }
}

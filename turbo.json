{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      "env": ["VITE_CONVEX_URL", "VITE_CONVEX_SITE_URL", "VITE_SITE_URL", "VITE_HAS_DEMO_LOGIN"]
    },
    "@isbabyoutyet/backend#deploy:vercel": {
      "cache": false
    },
    "@isbabyoutyet/backend#configure:vercel": {
      "dependsOn": ["deploy:vercel"],
      "cache": false
    },
    "@isbabyoutyet/web#build:vercel": {
      "dependsOn": ["^build", "@isbabyoutyet/backend#deploy:vercel"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [
        "node_modules/.cache/tsbuildinfo.json",
        "node_modules/.cache/tsbuildinfo.convex.json"
      ]
    },
    "test": {},
    "lint": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "lint-fix": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "format": {
      "dependsOn": ["@workspace/oxlint-plugins#build"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/.agents/**"]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/coverage-summary.json", "coverage/lcov.info"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.coverage.ts",
        "!**/*.md",
        "!**/.agents/**"
      ],
      "env": ["CI"]
    },
    "//#knip": {
      "cache": false
    }
  }
}

{
  "$schema": "./projects/isbabyoutyet/backend/node_modules/oxfmt/configuration_schema.json",
  // From `oxfmt --init`, plus ignores for generated code.
  "ignorePatterns": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "packages/oxlint-plugins/dist/**",
    "packages/scripts/dist/**",
    // Vendor Convex skills from `npx convex ai-files update` — oxfmt would
    // rewrite their fenced TS and undo the CLI install.
    "projects/isbabyoutyet/backend/.agents/skills/**",
    "projects/isbabyoutyet/backend/.claude/skills/**"
  ]
}

        "react/react-in-jsx-scope": "off",
        "react/no-unstable-nested-components": "off",
        "react/set-state-in-effect": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/immutability": "off",
        "react/refs": "off",
        "react/purity": "off",
        "react/set-state-in-render": "off",
        "react/hooks": "off",
        "react/static-components": "off",
        "react/preserve-manual-memoization": "off",
        "react/use-memo": "off",
        "react/void-use-memo": "off",
        "react/unsupported-syntax": "off",
        "react/incompatible-library": "off",
        "react/error-boundaries": "off",
        "react/globals": "off",
        "react/invariant": "off",
        "react/rule-suppression": "off",
        "react/syntax": "off",
        "react/todo": "off",
        "react/capitalized-calls": "off",
        "react/memo-dependencies": "off",
        "react/no-deriving-state-in-effects": "off",
        "react-hooks/exhaustive-deps": "off",
        "eqeqeq": "off",
        "react/button-has-type": "off",
        "@typescript-eslint/array-type": "off",
        "curly": "off",
        "import-x/no-namespace": "off",
        "object-shorthand": "off",
        "perfectionist/sort-enums": "off",
        "perfectionist/sort-heritage-clauses": "off",
        "perfectionist/sort-interfaces": "off",
        "perfectionist/sort-jsx-props": "off",
        "perfectionist/sort-object-types": "off",
        "perfectionist/sort-objects": "off",
        "prefer-arrow-callback": "off",
        "unicorn/prefer-string-raw": "off"
      }
    },
    {
      // Automatic JSX runtime — same as apps/web.
      "files": ["packages/email/**/*.{ts,tsx}"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      // Audited React-hook seams under lib (not the whole lib directory).
      // Timers/observers/stores may use effects and local state. Feature
      // components stay banned. React Compiler rules stay on so render-phase
      // ref access cannot hide in these seams.
      "files": ["apps/web/src/lib/use-*.{ts,tsx}", "apps/web/src/lib/overlay-nav.ts"],
      "rules": {
        "workspace/no-use-effect": "off",
        "workspace/no-use-state": "off"
      }
    },
    {
      // Audited external-store seam: the form leave-guard bridges Base UI
      // dismissal, form dirty state, and router blocking through one store.
      // The React layer needs a lazy useState store instance,
      // useSyncExternalStore for prompt state, and effects for store wiring.
      "files": ["packages/form-guard/src/**"],
      "rules": {
        "workspace/no-use-effect": "off",
        "workspace/no-use-state": "off"
      }
    },
    {
      // Process env validators, not schema/RPC — absence is "unset in this deploy".
      "files": ["packages/convex/convex/convex.config.ts"],
      "rules": {
        "workspace/no-undocumented-optional": "off"
      }
    },
    {
      // query-prefetch overloads use an optional third `remixInput` param (KATT gist API).
      "files": ["packages/query-prefetch/src/**"],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      // Render-time useState adjustment is required here: react/refs forbids
      // reading refs during render, and useSyncExternalStore needs a stable
      // subscribe identity when watch deps are deeply equal.
      "files": ["packages/convex-prefetch/src/useLiveConvexInfinitePages.ts"],
      "rules": {
        "workspace/no-use-state": "off"
      }
    },
    {
      // CLI / seed / coverage scripts — nkzw disables no-console for server scripts.
      // Convex uses console for dashboard logs.
      "files": [
        "**/scripts/**",
        "packages/scripts/src/**",
        "packages/convex/convex/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Latest dismiss is an Effect Event assigned onto the external store
      // each render; the compiler rule forbids passing Effect Events, but the
      // click handler is outside React and cannot be an Effect.
      "files": ["apps/web/src/lib/use-coachmark-store.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react/rules-of-hooks": "off"
      }
    },
    {
      // Field order is domain-grouped; sort-objects detaches @todo JSDoc from
      // v.optional() fields and trips workspace/no-undocumented-optional.
      "files": ["packages/convex/convex/schema.ts"],
      "rules": {
        "perfectionist/sort-objects": "off"
      }
    },
    {
      // TanStack Router infers loader/search/context types from option key
      // order (`validateSearch` before `loader`, `loader` before `head`).
      "files": ["apps/web/src/routes/**/*.{ts,tsx}"],
      "rules": {
        "perfectionist/sort-objects": "off"
      }
    }
  ]
}

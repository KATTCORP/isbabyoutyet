{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "extends": "@workspace/tsconfig/react.json",
  "compilerOptions": {
    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom", "ESNext.Disposable"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    /* Keep incremental info out of the functions dir the Convex bundler walks. */
    "tsBuildInfoFile": "${configDir}/../node_modules/.cache/tsbuildinfo.convex.json"
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}

{
  "name": "@isbabyoutyet/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/*": "./convex/*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "predev:kill": "lsof -ti:3210 -ti:3211 | xargs kill -9 2>/dev/null || true",
    "predev:setup-if-needed": "[ -f .env.local ] || pnpm setup-dev",
    "predev:env": "CONVEX_AGENT_MODE=anonymous tsx scripts/ensureLocalEnv.ts",
    "predev": "run-s predev:kill predev:setup-if-needed predev:env",
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev --local-force-upgrade --start 'pnpm dev:seed'",
    "dev:seed": "tsx scripts/seedHomepageDemo.ts || echo '⚠️  Homepage demo seed failed; Convex dev keeps running. Retry with `pnpm seed:homepage`.'",
    "reset-dev": "run-s predev:kill reset-dev:wipe && echo '✅ Reset complete, you can now run `pnpm dev` (which will set up + seed)'",
    "reset-dev:wipe": "sh scripts/wipe-local-backend.sh",
    "setup-dev": "CI=true CONVEX_AGENT_MODE=anonymous run-s setup-dev:provision setup-dev:env seed:demo-login && echo '✅ Setup complete, you can now run `pnpm dev` (it seeds the homepage demo once Convex is up)'",
    "setup-dev:provision": "convex dev --once --local-force-upgrade",
    "setup-dev:env": "CONVEX_AGENT_MODE=anonymous tsx scripts/ensureLocalEnv.ts",
    "deploy:vercel": "tsx scripts/deployVercel.ts",
    "configure:vercel": "tsx scripts/configureVercel.ts",
    "seed": "CONVEX_AGENT_MODE=anonymous run-s seed:demo-login seed:homepage",
    "seed:demo-login": "CONVEX_AGENT_MODE=anonymous convex run seed:seedDemoData",
    "seed:homepage": "CONVEX_AGENT_MODE=anonymous tsx scripts/seedHomepageDemo.ts",
    "seed:homepage:content": "CONVEX_AGENT_MODE=anonymous tsx scripts/seedHomepageDemo.ts --only content",
    "seed:homepage:photos": "CONVEX_AGENT_MODE=anonymous tsx scripts/seedHomepageDemo.ts --only photos",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "catalog:",
    "@effect/platform-node": "catalog:",
    "@isbabyoutyet/email": "workspace:*",
    "@workspace/convex-cli": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "convex-table-history": "catalog:",
    "effect": "catalog:",
    "sharp": "catalog:",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "@workspace/tsconfig": "workspace:*",
    "convex-test": "catalog:",
    "dotenv": "catalog:",
    "npm-run-all": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}

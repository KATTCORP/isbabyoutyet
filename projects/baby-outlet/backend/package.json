{
  "name": "@baby-outlet/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/*": "./convex/*.ts",
    "./convex/_generated/*": "./convex/_generated/*.js",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "predev:kill": "lsof -ti:3210 | xargs kill -9 2>/dev/null || true",
    "predev:setup-if-needed": "[ -f .env.local ] || pnpm setup-dev",
    "predev": "run-s predev:*",
    "dev": "CONVEX_AGENT_MODE=anonymous convex dev",
    "reset-dev": "run-s predev:kill reset-dev:wipe && echo '✅ Reset complete, you can now run `pnpm dev` (which will set up + seed)'",
    "reset-dev:wipe": "sh scripts/wipe-local-backend.sh",
    "setup-dev": "CONVEX_AGENT_MODE=anonymous run-s setup-dev:provision setup-dev:env setup-dev:vapid seed && echo '✅ Setup complete, you can now run `pnpm dev`'",
    "setup-dev:provision": "convex dev --once",
    "setup-dev:env": "convex env set BETTER_AUTH_SECRET localhost && convex env set SITE_URL http://localhost:3000",
    "setup-dev:vapid": "web-push generate-vapid-keys --json | jq -r '\"npx convex env set VAPID_PUBLIC_KEY \" + .publicKey + \"\\nnpx convex env set VAPID_PRIVATE_KEY \" + .privateKey' | sh",
    "seed": "CONVEX_AGENT_MODE=anonymous run-s seed:demo-login seed:homepage",
    "seed:demo-login": "CONVEX_AGENT_MODE=anonymous convex run seed:seedDemoData",
    "seed:homepage": "CONVEX_AGENT_MODE=anonymous tsx scripts/seedHomepageDemo.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "^0.3.6",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "^0.1.123",
    "convex-table-history": "^0.1.2",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.55",
    "npm-run-all": "^4.1.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "zod": "catalog:"
  }
}

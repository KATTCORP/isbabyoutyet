{
  "name": "@baby-outlet/web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "run-s predev:*",
    "predev:kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "predev:setup-if-needed": "[ -f .env.local ] || pnpm setup-dev",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --output-structure message-modules --emit-ts-declarations --silent",
    "pretypecheck": "pnpm i18n:compile",
    "test": "vitest run --project web",
    "test:overflow": "vitest run --project web-browser",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "setup-dev": "cp .env.example .env.local",
    "format:check": "oxfmt --check",
    "deploy-convex": "tsx scripts/deploy-convex.ts"
  },
  "dependencies": {
    "@baby-outlet/backend": "workspace:*",
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.30",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.47",
    "@vercel/analytics": "^2.0.1",
    "@workspace/convex-prefetch": "workspace:*",
    "@workspace/query-prefetch": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "date-fns": "^4.4.0",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "satori": "^0.29.0",
    "sonner": "catalog:",
    "streamdown": "^2.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.55",
    "jsdom": "^30.0.1",
    "nitro": "latest",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "^1.62.1",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.12",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "web-vitals": "^6.1.1"
  }
}
